# SQL Server (Compose sqlserver service + API connection password)
MSSQL_SA_PASSWORD=Your_strong_Password123

# API hosting
ASPNETCORE_ENVIRONMENT=Development

# JWT Bearer (must match Jwt section; Key >= 32 characters)
JWT_ISSUER=RedArbor.Inventory.AI
JWT_AUDIENCE=RedArbor.Inventory.AI
JWT_KEY=DevelopmentOnly_SuperSecretKey_AtLeast32Chars!
JWT_EXPIRATION_MINUTES=60

# GitHub OAuth App (Authorization Code → app JWT)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/callback
